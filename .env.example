# Payload CMS
PAYLOAD_SECRET=your-super-secret-key-min-32-chars-long

# Supabase PostgreSQL (Connection string from Supabase Dashboard > Connect)
# Use the "Transaction pooler" or "Direct connection" URI
DATABASE_URI=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Optional: Supabase S3 Storage for media uploads
# Create a bucket in Supabase Storage and add S3 credentials from Project Settings > Storage
S3_BUCKET=genetico
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ap-south-1
S3_ENDPOINT=https://[project-ref].supabase.co/storage/v1/s3

# Resend — the enquiry form (/api/contact)
# RESEND_FROM must be on a domain verified at https://resend.com/domains
# (until genetico.in is verified, Resend only delivers to the account owner).
# Where enquiries go is set in the CMS (Site-wide → Contact details & form);
# RESEND_TO / RESEND_CC are the fallback if that is empty.
RESEND_API_KEY=
RESEND_FROM=Genetico Website <website@genetico.in>
RESEND_TO=hello@genetico.in
RESEND_CC=

# Optional. Canonical origin for canonical tags, Open Graph, sitemap and robots.
# Defaults to https://genetico.in.
# NEXT_PUBLIC_SITE_URL=https://genetico.in

# Optional. Google Tag Manager container. Defaults to GTM-MHNFM4ZM; set to an
# empty value to switch Tag Manager off (e.g. for a staging deploy).
# NEXT_PUBLIC_GTM_ID=GTM-MHNFM4ZM
