# Normalise line endings: LF in the repo and in the working tree on every OS.
# Without this, Windows checkouts get CRLF and Prettier (endOfLine: "lf") fails
# format:check on every file.
* text=auto eol=lf

# Binary assets Git must never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.zip binary
*.pdf binary
*.mp4 binary
